# ============================================================
# StayApp — κοινό .gitignore (frontend + backend)
# Προέκυψε από τη συγχώνευση των δύο branches: το πάνω μισό
# αφορά το React, το κάτω το FastAPI/βάση.
# ============================================================

# ---------- Κοινά ----------
*.log

# Μεταβλητές περιβάλλοντος — ΠΟΤΕ στο git.
# Εξαίρεση: το .env.example, που είναι τεκμηρίωση χωρίς μυστικά.
.env
.env.*
!.env.example

# Πιστοποιητικά SSL — ΠΟΤΕ στο git (το key.pem είναι ιδιωτικό κλειδί)
certs/
*.pem

# ---------- Frontend (React / Vite / Node) ----------
/dist
/tmp
/out-tsc
/bazel-out
/node_modules
npm-debug.log
yarn-error.log

# Dataset συστάσεων — πολύ μεγάλα αρχεία για το git (>100MB).
# Μοιράζεται ξεχωριστά (e-class). ΔΕΝ ανεβαίνει στο repo.
/rel_event_csvs

# ---------- Backend (Python / FastAPI) ----------
# Εικονικό περιβάλλον (SOS)
venv/
env/
.venv/

# Compiled bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
get-pip.py

# Τοπικές βάσεις
*.sqlite3

# ---------- Editors / IDEs ----------
# Κρατάμε κοινή τη ρύθμιση του project, αγνοούμε τα προσωπικά.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# ---------- Λοιπά ----------
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# ---------- Αρχεία συστήματος ----------
.DS_Store
Thumbs.db
